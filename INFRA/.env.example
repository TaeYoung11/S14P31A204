# PostgreSQL Configuration
# 사용할 데이터베이스 이름
POSTGRES_DB=
# 데이터베이스 접속 사용자 계정
POSTGRES_USER=
# 데이터베이스 접속 비밀번호
POSTGRES_PASSWORD=

# Redis Configuration
# Redis 서버 호스트 주소 (기본값: redis)
REDIS_HOST=
# Redis 서버 포트 번호 (기본값: 6379)
REDIS_PORT=

# RabbitMQ Configuration
# RabbitMQ 접속 관리자 계정
RABBITMQ_DEFAULT_USER=
# RabbitMQ 접속 관리자 비밀번호
RABBITMQ_DEFAULT_PASS=

# MinIO Configuration
# MinIO 루트 사용자 계정 (S3 Access Key 역할)
MINIO_ROOT_USER=
# MinIO 루트 사용자 비밀번호 (S3 Secret Key 역할)
MINIO_ROOT_PASSWORD=
# 프로젝트에서 사용할 S3 버킷 이름
MINIO_BUCKET=

# Security & Mail
# JWT 토큰 서명에 사용되는 비밀 키 (임의의 긴 문자열 권장)
JWT_SECRET=
# SMTP 메일 발송을 위한 서비스 사용자 계정 (예: Gmail 주소)
MAIL_USERNAME=
# SMTP 메일 발송용 앱 비밀번호 (Google 앱 비밀번호 등)
MAIL_PASSWORD=

# VWorld API Configuration
# VWorld 지도 서비스 API 키 (https://www.vworld.kr/dev/v4api.do 에서 발급)
VWORLD_API_KEY=
# VWorld API 키 발급 시 등록한 Referer URL (예: http://localhost:80)
VWORLD_REFERER=

# Frontend Settings
# 카카오맵 API 키 (Javascript 키)
VITE_KAKAO_MAP_API_KEY=
# 프론트엔드에서 호출할 백엔드 API 서버의 기본 URL
VITE_API_URL=

# Deployment Settings
# 배포 서버의 공인 IP 또는 도메인 주소 (MinIO 콘솔 리다이렉션 등에 사용)
SERVER_IP=