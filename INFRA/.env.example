# Docker Compose
NGINX_HTTP_PORT=80
SERVER_IP=localhost
SPRING_PROFILES_ACTIVE=docker
ENVIRONMENT=staging
LOG_LEVEL=INFO
LOG_JSON=false

# PostgreSQL
POSTGRES_DB=batang
POSTGRES_USER=batang
POSTGRES_PASSWORD=batang
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/batang
SPRING_DATASOURCE_USERNAME=batang
SPRING_DATASOURCE_PASSWORD=batang
SPRING_SQL_INIT_MODE=always

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=batang
SPRING_REDIS_DATABASE=0
SPRING_REDIS_TIMEOUT=3s

# RabbitMQ
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_BIND=127.0.0.1

# MinIO / S3
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_BROWSER_REDIRECT_URL=http://localhost/minio/
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost
AWS_S3_BUCKET=batang-artifacts
AWS_S3_PRESIGN_EXPIRATION_SECONDS=300
AWS_S3_DELETE_QUEUE_KEY=workspace:floor-plan:s3:delete:queue
AWS_S3_DELETE_BATCH_SIZE=500
AWS_S3_DELETE_SCHEDULE_CRON=0 0 4 * * *
AWS_S3_DELETE_SCHEDULE_ZONE=Asia/Seoul
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123

# Security and mail
JWT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=

# VWorld
VWORLD_API_KEY=
VWORLD_BASE_URL=https://apis.vworld.kr
VWORLD_CADASTRAL_PATH=/2ddata/cadastral/data
VWORLD_REFERER=http://localhost
VWORLD_OUTPUT=json
VWORLD_SRS_NAME=EPSG:4326
VWORLD_PROPERTY_NAME=pnu,jibun,bonbun,bubun,ag_geom,addr
VWORLD_BUFFER=10
VWORLD_PAGE_INDEX=1
VWORLD_PAGE_UNIT=10
VWORLD_TIMEOUT_SECONDS=3

# Frontend build
VITE_API_URL=/api/v1
VITE_KAKAO_MAP_API_KEY=

# AI workers
IFC_GENERATE_WORKER_ID=ifc-generate-worker-1
TWO_D_LLM_WORKER_ID=planning-2d-worker-1
THREE_D_LLM_WORKER_ID=planning-3d-worker-1
AUTHORING_WORKER_ID=authoring-worker-1
RENDERING_WORKER_ID=rendering-worker-1
AI_WORKER_TEMP_DIR=/tmp/ai-layout-import
TWO_D_LLM_MODEL_NAME=gemma3:4b
TWO_D_LLM_BASE_URL=http://host.docker.internal:11434/v1
TWO_D_LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5:7b
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_REASONING_EFFORT=none
