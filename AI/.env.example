# Root AI worker environment template

# ── Worker identity ───────────────────────────────────────────────────────────
WORKER_TYPE=
WORKER_ID=

# ── RabbitMQ (RABBITMQ_ prefix → RabbitMQSettings) ───────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── S3 / MinIO (S3_ prefix → S3Settings) ─────────────────────────────────────
S3_BUCKET=
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
