# Root AI worker environment template

# ── Worker identity ───────────────────────────────────────────────────────────
WORKER_TYPE=
WORKER_ID=

# ── RabbitMQ (RABBITMQ_ prefix → RabbitMQSettings) ───────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── S3 / MinIO — will be added in a follow-up commit ─────────────────────────
S3_BUCKET_NAME=
