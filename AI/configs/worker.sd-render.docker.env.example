# Docker runtime env for the SD render worker.
# Use this file from the AI directory:
#   docker run --rm --env-file configs/worker.sd-render.docker.env.example batang-ai-worker:sd-render --help

WORKER_TYPE=SD_RENDER_GENERATE
WORKER_ID=sd-render-worker-1
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Inside a Docker container, localhost is the container itself.
# Use host.docker.internal for RabbitMQ/MinIO published on the host.
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Disable AMQP heartbeat for long first-run smoke tests where model download can
# block the consumer loop. Use a positive value in production if the worker can
# keep heartbeats flowing while long jobs run.
RABBITMQ_HEARTBEAT=0

S3_BUCKET=batang-artifacts
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_REGION=us-east-1

# Keep model cache under a stable path and mount it from the host during smoke:
#   -v "$env:USERPROFILE\.cache\huggingface:/root/.cache/huggingface"
HF_HOME=/root/.cache/huggingface
