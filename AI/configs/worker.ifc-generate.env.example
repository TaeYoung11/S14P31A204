# IFC generate 워커 전용 환경 예제
WORKER_TYPE=IFC_GENERATE_FROM_BUBBLE
WORKER_ID=ifc-generate-worker-1
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

S3_BUCKET=batang-artifacts
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_REGION=us-east-1

# 비우면 기본 임시 경로를 사용한다.
AI_WORKER_TEMP_DIR=.tmp/ai-layout-import
