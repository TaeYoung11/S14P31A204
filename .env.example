# ────────────────────────────────────────
# LLM 설정 (Ollama 로컬)
# ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_CONTEXT_LIMIT=4096

# ────────────────────────────────────────
# 데이터베이스
# ────────────────────────────────────────
DATABASE_URL=postgresql://bim3d:bim3d_secret@localhost:5432/bim3d
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────
# 파일 저장소
# ────────────────────────────────────────
IFC_STORAGE_PATH=./storage/ifc
BACKUP_STORAGE_PATH=./storage/backups
MAX_IFC_FILE_SIZE_MB=200

# ────────────────────────────────────────
# 백엔드 설정
# ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ────────────────────────────────────────
# 프론트엔드 설정 (Vite .env)
# ────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ────────────────────────────────────────
# Floor Planner 설정
# ────────────────────────────────────────
FLOOR_SIMULATION_MAX_ITERATIONS=500
FLOOR_SIMULATION_DEFAULT_ITERATIONS=300
