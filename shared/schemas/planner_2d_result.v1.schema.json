{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a204.batang/shared/schemas/planner_2d_result.v1.schema.json",
  "title": "Planner2DResultV1",
  "description": "ai-planning-2d가 wrapper를 통해 EngineRequestV2로 변환하기 전에 반환하는 정규화된 결과.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planner_type",
    "request_id",
    "project_id",
    "base_revision_id",
    "source_scene_type",
    "status",
    "commands",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "planner_type": {
      "const": "2d"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project_id": {
      "$ref": "#/$defs/safeId"
    },
    "base_revision_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/safeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_scene_type": {
      "const": "SCENE_2D"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "clarification_required", "invalid_instruction"]
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planner2dCommand"
      }
    },
    "clarification": {
      "oneOf": [
        {
          "$ref": "#/$defs/clarification"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plannerIssue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "commands": {
            "minItems": 1
          },
          "issues": {
            "items": {
              "$ref": "#/$defs/nonErrorPlannerIssue"
            }
          },
          "clarification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "clarification_required"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["clarification"],
        "properties": {
          "commands": {
            "maxItems": 0
          },
          "issues": {
            "items": {
              "$ref": "#/$defs/nonErrorPlannerIssue"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_instruction"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "commands": {
            "maxItems": 0
          },
          "issues": {
            "minItems": 1,
            "contains": {
              "$ref": "#/$defs/errorPlannerIssue"
            }
          },
          "clarification": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "shapePreset": {
      "type": "string",
      "enum": ["RECT", "L", "U", "POLYGON", "OTHER"]
    },
    "roomType": {
      "type": "string",
      "enum": [
        "living",
        "bedroom",
        "kitchen",
        "bathroom",
        "office",
        "corridor",
        "other"
      ]
    },
    "rect2dMm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "polygon2d": {
      "description": "절대 프로젝트 전역 좌표계(mm)의 표준 polygon ring. open ring으로 직렬화한다(첫 점을 마지막에 반복하지 않음). outer boundary는 CCW(반시계) winding으로 저장한다. 연속된 중복/collinear 점은 제거하고 self-intersection을 피한다.",
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/rectPoint2dMm"
      }
    },
    "rectPoint2dMm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "plannerIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "nonErrorPlannerIssue": {
      "allOf": [
        {
          "$ref": "#/$defs/plannerIssue"
        },
        {
          "properties": {
            "severity": {
              "enum": ["info", "warning"]
            }
          }
        }
      ]
    },
    "errorPlannerIssue": {
      "allOf": [
        {
          "$ref": "#/$defs/plannerIssue"
        },
        {
          "properties": {
            "severity": {
              "const": "error"
            }
          }
        }
      ]
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      }
    },
    "twoDTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": {
          "const": "space"
        },
        "room_id": {
          "description": "소스 scene에 안정적인 방 식별자가 있을 때 사용하는 scene room id. IFC GlobalId가 아니다.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "floor": {
          "type": "integer",
          "minimum": 1
        },
        "apply_to_all": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "twoDTargetMatchRule": {
      "anyOf": [
        {
          "required": ["room_id"]
        },
        {
          "required": ["name"]
        },
        {
          "required": ["apply_to_all"],
          "properties": {
            "apply_to_all": {
              "const": true
            }
          }
        }
      ]
    },
    "twoDCreateInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "room_type", "floor", "shape", "width_mm", "height_mm"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "room_type": {
          "$ref": "#/$defs/roomType"
        },
        "floor": {
          "type": "integer",
          "minimum": 1
        },
        "shape": {
          "$ref": "#/$defs/shapePreset"
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rects_mm": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rect2dMm"
          }
        },
        "polygon_mm": {
          "$ref": "#/$defs/polygon2d"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "enum": ["RECT", "L", "U"]
              }
            },
            "required": ["shape"]
          },
          "then": {
            "required": ["rects_mm"],
            "not": {
              "required": ["polygon_mm"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "enum": ["POLYGON", "OTHER"]
              }
            },
            "required": ["shape"]
          },
          "then": {
            "required": ["polygon_mm"],
            "not": {
              "required": ["rects_mm"]
            }
          }
        }
      ]
    },
    "twoDChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "shape": {
          "$ref": "#/$defs/shapePreset"
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rects_mm": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rect2dMm"
          }
        },
        "polygon_mm": {
          "$ref": "#/$defs/polygon2d"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "not": {
            "allOf": [
              {
                "required": ["rects_mm"]
              },
              {
                "required": ["polygon_mm"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "enum": ["RECT", "L", "U"]
              }
            },
            "required": ["shape"]
          },
          "then": {
            "required": ["rects_mm"],
            "not": {
              "required": ["polygon_mm"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "enum": ["POLYGON", "OTHER"]
              }
            },
            "required": ["shape"]
          },
          "then": {
            "required": ["polygon_mm"],
            "not": {
              "required": ["rects_mm"]
            }
          }
        }
      ]
    },
    "planner2dCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_type", "target", "confidence", "raw_instruction"],
      "properties": {
        "command_type": {
          "type": "string",
          "enum": ["CREATE", "MODIFY", "DELETE"]
        },
        "target": {
          "$ref": "#/$defs/twoDTarget"
        },
        "changes": {
          "oneOf": [
            {
              "$ref": "#/$defs/twoDChanges"
            },
            {
              "type": "null"
            }
          ]
        },
        "create_info": {
          "oneOf": [
            {
              "$ref": "#/$defs/twoDCreateInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "raw_instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "CREATE"
              }
            },
            "required": ["command_type"]
          },
          "then": {
            "required": ["create_info"],
            "properties": {
              "changes": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "MODIFY"
              }
            },
            "required": ["command_type"]
          },
          "then": {
            "required": ["changes"],
            "properties": {
              "target": {
                "allOf": [
                  {
                    "$ref": "#/$defs/twoDTarget"
                  },
                  {
                    "$ref": "#/$defs/twoDTargetMatchRule"
                  }
                ]
              },
              "create_info": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "DELETE"
              }
            },
            "required": ["command_type"]
          },
          "then": {
            "properties": {
              "target": {
                "allOf": [
                  {
                    "$ref": "#/$defs/twoDTarget"
                  },
                  {
                    "$ref": "#/$defs/twoDTargetMatchRule"
                  }
                ]
              },
              "changes": {
                "type": "null"
              },
              "create_info": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "schema_version": "v1",
      "planner_type": "2d",
      "request_id": "req-2d-001",
      "project_id": "project-001",
      "base_revision_id": "rev_20260423T120000Z_ab12cd34",
      "source_scene_type": "SCENE_2D",
      "status": "ready",
      "commands": [
        {
          "command_type": "MODIFY",
          "target": {
            "domain": "space",
            "name": "Living Room",
            "floor": 1,
            "apply_to_all": false
          },
          "changes": {
            "shape": "L",
            "width_mm": 6000,
            "height_mm": 8000,
            "rects_mm": [
              {
                "x": 0,
                "y": 0,
                "width": 6000,
                "height": 4000
              },
              {
                "x": 0,
                "y": 4000,
                "width": 3000,
                "height": 4000
              }
            ]
          },
          "confidence": 0.95,
          "raw_instruction": "Resize living room to L 6000x8000"
        }
      ],
      "issues": []
    }
  ]
}
