{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a204.batang/shared/schemas/scene_3d_context_v1.schema.json",
  "title": "Scene3DContextV1",
  "description": "Normalized 3D scene context used by ai-planning-3d instead of raw IFC. Large models must be truncated before planning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_type",
    "scene_id",
    "name",
    "units",
    "storeys",
    "elements"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "scene_type": {
      "const": "SCENE_3D"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "units": {
      "const": "mm"
    },
    "storeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/storey"
      }
    },
    "spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "space_boundary_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spaceBoundaryLink"
      }
    },
    "elements": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "globalId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_$]{22}$"
    },
    "elementType": {
      "type": "string",
      "enum": [
        "IfcWall",
        "IfcSlab",
        "IfcColumn",
        "IfcBeam",
        "IfcDoor",
        "IfcWindow",
        "IfcStair",
        "IfcRoof",
        "IfcSpace",
        "IfcOpeningElement"
      ]
    },
    "direction": {
      "type": "string",
      "enum": ["North", "South", "East", "West"]
    },
    "color": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(#[0-9A-Fa-f]{6}|[A-Za-z][A-Za-z0-9 _-]{0,63})$"
    },
    "point3Mm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "bbox3dMm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "$ref": "#/$defs/point3Mm"
        },
        "max": {
          "$ref": "#/$defs/point3Mm"
        }
      }
    },
    "dimensionsMm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "storey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "index", "elevation_mm", "height_mm"],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "elevation_mm": {
          "type": "number"
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_id", "name", "storey"],
      "properties": {
        "global_id": {
          "$ref": "#/$defs/globalId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "long_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "storey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "bbox_mm": {
          "$ref": "#/$defs/bbox3dMm"
        },
        "centroid_mm": {
          "$ref": "#/$defs/point3Mm"
        }
      }
    },
    "spaceBoundaryLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space_global_id", "element_global_id"],
      "properties": {
        "space_global_id": {
          "$ref": "#/$defs/globalId"
        },
        "element_global_id": {
          "$ref": "#/$defs/globalId"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_id", "element_type"],
      "properties": {
        "global_id": {
          "$ref": "#/$defs/globalId"
        },
        "element_type": {
          "$ref": "#/$defs/elementType"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "storey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "space_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "azimuth_deg": {
          "type": "number"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "placement_mm": {
          "$ref": "#/$defs/point3Mm"
        },
        "bbox_mm": {
          "$ref": "#/$defs/bbox3dMm"
        },
        "dimensions_mm": {
          "$ref": "#/$defs/dimensionsMm"
        },
        "material": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_scene_state_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updated_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "total_element_count": {
          "type": "integer",
          "minimum": 0
        },
        "is_truncated": {
          "type": "boolean"
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "v1",
      "scene_type": "SCENE_3D",
      "scene_id": "scene-state-3d-001",
      "name": "sample-3d-context",
      "units": "mm",
      "storeys": [
        {
          "id": "storey-1",
          "name": "1F",
          "index": 1,
          "elevation_mm": 0,
          "height_mm": 2800
        }
      ],
      "elements": [
        {
          "global_id": "0J$AbcDEfGhijkLMNOpqrs",
          "element_type": "IfcWall",
          "name": "Wall-001",
          "storey": "1F",
          "direction": "North",
          "azimuth_deg": 0,
          "dimensions_mm": {
            "length": 5000,
            "width": 200,
            "height": 2800
          }
        }
      ],
      "metadata": {
        "total_element_count": 1,
        "is_truncated": false
      }
    }
  ]
}
