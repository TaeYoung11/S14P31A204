{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a204.batang/shared/schemas/three_d_llm_generate.payload.schema.json",
  "title": "ThreeDLlmGeneratePayload",
  "description": "Payload for THREE_D_LLM_GENERATE worker command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "user_instruction"],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "user_instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "source_scene_storage_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_scene": {
      "$ref": "https://a204.batang/shared/schemas/scene_3d_context_v1.schema.json"
    },
    "conversation_history": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/chatMessage"
      }
    },
    "planner_options": {
      "$ref": "#/$defs/plannerOptions"
    }
  },
  "oneOf": [
    {
      "required": ["source_scene_storage_url"]
    },
    {
      "required": ["source_scene"]
    }
  ],
  "$defs": {
    "chatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["system", "user", "assistant"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "plannerOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_create": {
          "type": "boolean"
        },
        "allow_delete": {
          "type": "boolean"
        },
        "allow_modify": {
          "type": "boolean"
        },
        "max_commands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "host_wall_global_id": {
          "description": "Clarification answer: IFC GlobalId of the host wall selected by the user for door/window placement.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
