{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a204.batang/shared/schemas/sd_render_generate.payload.schema.json",
  "title": "SdRenderGeneratePayload",
  "description": "Payload for SD_RENDER_GENERATE worker command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt"],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "negative_prompt": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4000
    },
    "source_image_storage_url": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
