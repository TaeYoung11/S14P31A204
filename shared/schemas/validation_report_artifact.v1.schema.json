{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a204.batang/shared/schemas/validation_report_artifact.v1.schema.json",
  "title": "ValidationReportArtifactV1",
  "description": "MinIO engine/validation-report.v1.json 에 기록되는 아티팩트. plan 검증 및 IFC preview 검증 결과를 담는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "job_id",
    "step_no",
    "plan_validation_issues",
    "plan_validation_warnings",
    "preview_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "step_no": {
      "type": "integer",
      "minimum": 1
    },
    "plan_validation_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationIssue" }
    },
    "plan_validation_warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationIssue" }
    },
    "preview_warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ifc_validation_issues": {
      "description": "IFC 레벨 검증 결과. IFC 없는 clarification 케이스에서는 null.",
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/validationIssue" } },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["error", "warning"] },
        "message": { "type": "string", "minLength": 1 },
        "context": { "type": "object" }
      }
    }
  }
}
